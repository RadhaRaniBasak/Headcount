# Server & PayPal mode ("mock" for offline testing, "sandbox" for real PayPal Sandbox API)
PORT=3000
PAYPAL_MODE=sandbox

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox; Payouts enabled)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox personal accounts that receive the payout (email only, no password)
PROJECT_EMAILS=

# Sandbox buyer logins, used only by the demo script to approve payments on PayPal's page
DEMO_DONOR_EMAIL=
DEMO_DONOR_PASSWORD=
DEMO_UNVERIFIED_EMAIL=
DEMO_UNVERIFIED_PASSWORD=

# Optional: shows the real AI planner instead of the keyword fallback
LLM_API_KEY=
LLM_MODEL=

# Set to true only if "npm run gate" shows PayPal returns no account_status in your sandbox.
COUNT_UNKNOWN_STATUS=false

# Optional
# PORT=3000
# DATA_FILE=./data/db.json
